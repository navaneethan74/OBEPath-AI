# ==============================================================================
# OBEPath AI - Production Hardened Environment Variables (Free-Tier Deploy)
# Vercel Frontend | Render Backend | Neon Postgres Database
# ==============================================================================

# Environment mode ('production' enforces strict checks, 'development' for local)
ENV=production

# Server Port (Injected automatically by Render / Heroku / Cloud Run)
PORT=8000

# Production CORS Allowed Origins (REQUIRED in production: explicit comma-separated list; '*' is rejected)
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Database Connection URL (REQUIRED in production: Neon PostgreSQL, SQLite is strictly rejected)
# Example: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/obe_learning?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# JWT Secret for cryptographic session tokens (REQUIRED: minimum 32 characters)
JWT_SECRET=your_super_secret_key_at_least_32_characters_long

# Reverse Proxy Trust (Set to true on Render/Heroku so client IP is read from X-Forwarded-For)
TRUST_PROXY=true

# Admin Bootstrap (Render free tier has no shell access)
# If no admin exists in the database on startup, an admin is created once using these credentials.
# Must satisfy password rules (min 8 chars, >=1 letter, >=1 number). Passwords are never logged.
ADMIN_EMAIL=admin@yourinstitution.edu
ADMIN_PASSWORD=YourStrongAdminPassword123!
ADMIN_NAME=System Administrator

# Google Gemini API key (REQUIRED for generative tutoring & dynamic lessons)
# Stored on backend ONLY - never exposed to the frontend bundle
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Google Client ID for OAuth2 token verification (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional rate limit override for faculty operations (Default: 120 requests/minute)
FACULTY_RATE_LIMIT=120
